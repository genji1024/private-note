# ============================================================
# private-note environment variables
#
# [BUILD-TIME] NEXT_PUBLIC_* は `next build` 時にクライアント
# バンドルへ埋め込まれる。Docker デプロイでは docker-compose の
# `build.args` から渡すこと（変更時はイメージの再ビルドが必要）。
# ローカル開発では起動前に必ず設定しておくこと。
#
# [RUNTIME] 上記以外はサーバー側で実行時に読み取られる秘密情報。
# Docker デプロイでは runtime 環境変数として渡す。
# ============================================================

# --- Postgres（プレーンな Postgres。移行先のデータベース） ---
# [RUNTIME] drizzle/pg の Pool 接続文字列。
# docker compose では postgres サービスを指す（ユーザー/DB は POSTGRES_* と一致）。
DATABASE_URL=postgres://app:app@postgres:5432/private_note

# --- MinIO（S3 互換オブジェクトストレージ。Supabase Storage の移行先） ---
# [RUNTIME] MinIO サーバーエンドポイント（アプリコンテナから見たアドレス）
MINIO_ENDPOINT=minio:9000
# [RUNTIME] MinIO S3 API 用リージョン（未指定時は ap-northeast-1）
MINIO_REGION=ap-northeast-1
# [RUNTIME] MinIO ルート認証情報（docker-compose の MINIO_ROOT_USER/PASSWORD と一致）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# [RUNTIME] アップロード先バケット名
MINIO_BUCKET=images
# [RUNTIME] ブラウザから画像を参照する際の公開 URL
MINIO_PUBLIC_URL=http://localhost:9000

# サブパスデプロイ
# [BUILD-TIME] Nginx で /note/ 配下にデプロイする場合は /note。
# ルートドメイン直下（https://note.example.com/）にデプロイする場合は空欄のまま。
NEXT_PUBLIC_BASE_PATH=

# HTTP ポート
# ポート番号の単一の情報源（デフォルト値は持たないため設定必須）。
# ビルド時に compose の build.args から渡され、Dockerfile の ENV PORT・
# EXPOSE と ports マッピングに反映される。
PORT=3002

# NextAuth
# [RUNTIME] セッション JWT 署名用の秘密鍵（openssl rand -base64 32 で生成）
NEXTAUTH_SECRET=
# [RUNTIME] 本番では VPS の URL（例: https://note.example.com）
# ローカル開発では PORT と同じポート番号にすること（例: PORT=3002 なら http://localhost:3002）
NEXTAUTH_URL=http://localhost:3002

# Web Push (VAPID)
# [BUILD-TIME]
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# [RUNTIME]
VAPID_PRIVATE_KEY=
# [RUNTIME]
VAPID_SUBJECT=mailto:admin@example.com
